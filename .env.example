# JARVIS PC — kopjoje këtë file si ".env" dhe mbush çelësat e tu.
# Të gjithë merren FALAS. Udhëzimet e plota: README-JARVIS-AL.md

# 1) LiveKit Cloud — https://cloud.livekit.io  (projekt falas -> Settings -> Keys)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://xxxx.livekit.cloud

# 2) Google AI Studio (Gemini) — https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# 3) Kërkimi në web — DuckDuckGo (FALAS, PA ÇELËS — s'duhet asgjë)
#    (Google e hoqi "Search the entire web" për engine-e të rinj, ndaj u ndërrua)

# 4) OpenWeather — https://openweathermap.org/api  (regjistrohu falas -> API keys)
OPENWEATHER_API_KEY=

# Opsionale: dosjet ku Jarvis kërkon file-e (ndarë me ;). Bosh = Desktop/Documents/Downloads/Home
# JARVIS_SEARCH_DIRS=C:\Users\Emri\Desktop;C:\Users\Emri\Documents

# Opsionale: porti i faqes së zërit dhe emri i dhomës
# JARVIS_PORT=8765
# JARVIS_ROOM=jarvis-room
